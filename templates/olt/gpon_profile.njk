! Generated by NetForge for {{ device.hostname }} (OLT {{ (olt.vendor if olt and olt.vendor else "generic") | upper }})
!
configure terminal
hostname {{ device.hostname }}
!
! VLAN Database
{% for v in vlans %}
vlan {{ v.id }}
 name {{ v.name }}
!
{% endfor %}
! Management Interface
interface vlanif 1
 ip address {{ device.mgmt_ip | ip_only }} {{ device.mgmt_ip | subnet_mask }}
exit
{% if device.gateway %}
ip route 0.0.0.0 0.0.0.0 {{ device.gateway }}
{% endif %}
!
! Uplink Trunk Interfaces
{% set vlan_ids = [] %}
{% for v in vlans %}
  {% set _ = vlan_ids.push(v.id) %}
{% endfor %}
{% for iface in interfaces.trunk %}
interface {{ iface }}
 switchport mode trunk
 switchport trunk allowed vlan {{ vlan_ids | join(",") }}
exit
!
{% endfor %}
{% if olt and olt.dba_profiles and olt.dba_profiles.length > 0 %}
! DBA Bandwidth Profiles
{% for dba in olt.dba_profiles %}
dba-profile add profile-id {{ dba.id }} profile-name "{{ dba.name }}" type4 max {{ dba.bandwidth_kbps }}
{% endfor %}
!
{% endif %}
{% if olt and olt.ont_profiles and olt.ont_profiles.length > 0 %}
{% set default_dba_id = olt.dba_profiles[0].id if olt.dba_profiles and olt.dba_profiles.length > 0 else 1 %}
! ONT Line & Service Profiles
{% for ont in olt.ont_profiles %}
ont-lineprofile gpon profile-id {{ ont.profile_id }} profile-name "{{ ont.name }}"
 tcont 1 dba-profile-id {{ default_dba_id }}
 gem add 1 eth tcont 1
 gem mapping 1 0 vlan {{ ont.vlan_id }}
 commit
 quit
!
ont-srvprofile gpon profile-id {{ ont.profile_id }} profile-name "{{ ont.name }}"
 ont-port eth 4 pots 0
 port vlan eth 1 translation {{ ont.vlan_id }} user-vlan {{ ont.vlan_id }}
 commit
 quit
!
{% endfor %}
{% endif %}
{% if olt and olt.pon_ports and olt.pon_ports.length > 0 and olt.ont_profiles and olt.ont_profiles.length > 0 %}
! PON Service-Port & VLAN Flow Mapping
{% for port in olt.pon_ports %}
interface gpon 0/{{ port }}
{% for ont in olt.ont_profiles %}
 service-port vlan {{ ont.vlan_id }} gpon 0/{{ port }} ont all gemport 1 multi-service user-vlan {{ ont.vlan_id }}{% if ont.upload_limit %} rx-cttr {{ ont.upload_limit }}{% endif %}{% if ont.download_limit %} tx-cttr {{ ont.download_limit }}{% endif %}

{% endfor %}
exit
!
{% endfor %}
{% endif %}
end
write memory

