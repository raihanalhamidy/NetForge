# Generated by NetForge for {{ device.hostname }} (MikroTik RouterOS)

/system identity set name="{{ device.hostname }}"

/interface bridge add name=bridge1 vlan-filtering=yes

# Bridge Ports - Trunk
{% for iface in interfaces.trunk %}
/interface bridge port add bridge=bridge1 interface={{ iface }}
{% endfor %}

{% if interfaces.access and interfaces.access.length > 0 %}
# Bridge Ports - Access
{% for acc in interfaces.access %}
/interface bridge port add bridge=bridge1 interface={{ acc.name }} pvid={{ acc.vlan_id }}
{% endfor %}
{% endif %}

# VLAN Interfaces
{% for vlan in vlans %}
/interface vlan add interface=bridge1 name={{ vlan.name }} vlan-id={{ vlan.id }}{% if vlan.description %} comment="{{ vlan.description }}"{% endif %}

{% endfor %}

# Bridge VLAN Filtering Table
{% for vlan in vlans %}
{% set untagged = [] %}
{% if interfaces.access %}
  {% for acc in interfaces.access %}
    {% if acc.vlan_id == vlan.id %}
      {% set _ = untagged.push(acc.name) %}
    {% endif %}
  {% endfor %}
{% endif %}
/interface bridge vlan add bridge=bridge1 tagged={{ interfaces.trunk | join(",") }}{% if untagged.length > 0 %} untagged={{ untagged | join(",") }}{% endif %} vlan-ids={{ vlan.id }}
{% endfor %}

# Management IP & Routing
/ip address add address={{ device.mgmt_ip }} interface=bridge1
{% if device.gateway %}
/ip route add dst-address=0.0.0.0/0 gateway={{ device.gateway }}
{% endif %}

