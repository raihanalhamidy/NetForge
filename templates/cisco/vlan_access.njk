! Generated by NetForge for {{ device.hostname }} (Cisco IOS)
!
hostname {{ device.hostname }}
!
{% for v in vlans %}
vlan {{ v.id }}
 name {{ v.name }}
!
{% endfor %}
interface Vlan1
 description Management Interface
 ip address {{ device.mgmt_ip | ip_only }} {{ device.mgmt_ip | subnet_mask }}
 no shutdown
!
{% if device.gateway %}
ip default-gateway {{ device.gateway }}
!
{% endif %}
{% set vlan_ids = [] %}
{% for v in vlans %}
  {% set _ = vlan_ids.push(v.id) %}
{% endfor %}
{% for iface in interfaces.trunk %}
interface {{ iface }}
 description Trunk Port
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan {{ vlan_ids | join(",") }}
 no shutdown
!
{% endfor %}
{% if interfaces.access and interfaces.access.length > 0 %}
{% for acc in interfaces.access %}
interface {{ acc.name }}
 switchport mode access
 switchport access vlan {{ acc.vlan_id }}
 spanning-tree portfast
 no shutdown
!
{% endfor %}
{% endif %}
end

